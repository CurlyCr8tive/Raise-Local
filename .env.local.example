# Copy this file to .env.local and add the keys locally.
# Never commit .env.local or place these values in frontend JavaScript.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gmail OAuth is optional. Keep these values server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4102/api/gmail/oauth2callback
GMAIL_NOTIFICATION_EMAIL=
# Comma-separated deployed origins that may trigger automated Gmail sends.
# Example: https://raise-local.example.com,https://preview.example.com
GMAIL_ALLOWED_ORIGINS=

# Supabase Admin helpers. Required only for local handoff scripts that audit
# live data or provision real accounts. Never expose the service role key in
# browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
