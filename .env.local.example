# Copy this file to .env.local and add the keys locally.
# Never commit .env.local or place these values in frontend JavaScript.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase anon/public key is safe for the browser and used server-side only
# to verify authenticated admin tokens before sending email.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gmail OAuth is optional. Keep these values server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4102/api/gmail/oauth2callback
APP_BASE_URL=http://localhost:4102
GMAIL_NOTIFICATION_EMAIL=
# Comma-separated deployed origins that may trigger automated Gmail sends.
# Example: https://raise-local.example.com,https://preview.example.com
GMAIL_ALLOWED_ORIGINS=

# Optional isolated inbox for /api/gmail/send-test; never use this for live notifications.
GMAIL_TEST_RECIPIENT_EMAIL=
GMAIL_ADMIN_EMAILS=
# For a hosted server, store the OAuth refresh token in the host's secret
# manager instead of relying on the local .gmail-token.json file.
GMAIL_REFRESH_TOKEN=
# Required on hosted environments before opening /api/gmail/connect.
GMAIL_SETUP_TOKEN=

# Supabase Admin helpers. Required only for local handoff scripts that audit
# live data or provision real accounts. Never expose the service role key in
# browser code.
SUPABASE_SERVICE_ROLE_KEY=
